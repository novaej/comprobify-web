generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid(7)) @db.Uuid
  email         String    @unique
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  passwordHash  String?   @map("password_hash")
  emailVerified Boolean   @default(false) @map("email_verified")
  active        Boolean   @default(true)
  tenantId      String?   @map("tenant_id") @db.Uuid
  role          String?
  inviteStatus  String    @default("ACTIVE") @map("invite_status")
  invitedAt     DateTime? @map("invited_at")
  acceptedAt    DateTime? @map("accepted_at")
  isSuperAdmin  Boolean   @default(false) @map("is_super_admin")
  createdAt     DateTime  @default(now()) @map("created_at")
  tenant       Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issuerAccess UserIssuerAccess[]

  @@index([tenantId, role])
  @@map("users")
}

model Tenant {
  id           String         @id @default(uuid(7)) @db.Uuid
  apiTenantId  String         @unique @map("api_tenant_id") @db.Uuid
  ruc          String         @unique @db.VarChar(13)
  businessName String         @map("business_name")
  tradeName    String?        @map("trade_name")
  environment  String         @default("sandbox")
  status       String         @default("ACTIVE")
  intendedTier String?        @map("intended_tier")
  intendedBillingInterval String? @map("intended_billing_interval")
  pendingBankTransfer Json?  @map("pending_bank_transfer")
  contactEmail String?        @map("contact_email")
  createdAt    DateTime       @default(now()) @map("created_at")
  apiKeys      TenantApiKey[]
  issuers      Issuer[]
  users        User[]
  issuerAccess UserIssuerAccess[]
  products     Product[]
  clients      Client[]
  documentTemplates DocumentTemplate[]

  @@map("tenants")
}

model TenantApiKey {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  apiKeyId     String    @unique @map("api_key_id") @db.Uuid
  label        String
  environment  String
  encryptedKey String    @map("encrypted_key")
  lastFour     String    @map("last_four") @db.VarChar(4)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  revokedAt    DateTime? @map("revoked_at")
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("tenant_api_keys")
}

model Issuer {
  id             String   @id @default(uuid(7)) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  apiIssuerId    String   @unique @map("api_issuer_id") @db.Uuid
  branchCode     String   @map("branch_code") @db.VarChar(3)
  issuePointCode String   @map("issue_point_code") @db.VarChar(3)
  businessName   String   @map("business_name")
  tradeName      String?  @map("trade_name")
  branchAddress  String?  @map("branch_address")
  isDefault      Boolean  @default(false) @map("is_default")
  active         Boolean  @default(true) @map("active")
  createdAt      DateTime @default(now()) @map("created_at")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  access         UserIssuerAccess[]

  @@unique([tenantId, branchCode, issuePointCode])
  @@index([tenantId])
  @@map("issuers")
}

model UserIssuerAccess {
  id       String @id @default(uuid(7)) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  issuerId String @map("issuer_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  issuer   Issuer @relation(fields: [issuerId], references: [id], onDelete: Cascade)

  @@unique([userId, issuerId])
  @@index([userId, tenantId])
  @@map("user_issuer_access")
}

model Product {
  id          String   @id @default(uuid(7)) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  mainCode    String   @map("main_code") @db.VarChar(25)
  auxCode     String?  @map("aux_code") @db.VarChar(25)
  description String
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 6)
  taxOption   String   @map("tax_option") @db.VarChar(10)
  createdAt   DateTime @default(now()) @map("created_at")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("products")
}

model Client {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  idType    String   @map("id_type") @db.VarChar(5)
  idNumber  String   @map("id_number") @db.VarChar(20)
  name      String
  email     String
  address   String?
  createdAt DateTime @default(now()) @map("created_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("clients")
}

/// A saved, reusable starting point for creating a document (currently only
/// invoices — documentType '01' — but the shape generalizes to other SRI
/// document types as the create flows for those are built).
model DocumentTemplate {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  documentType String   @default("01") @map("document_type") @db.VarChar(2)
  name         String
  data         Json
  createdAt    DateTime @default(now()) @map("created_at")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, documentType, name])
  @@index([tenantId, documentType])
  @@map("document_templates")
}

// ── Notifications ─────────────────────────────────────────────────────────────

/// A notification mirrored from the Comprobify API. Upserted on every webhook
/// delivery or catch-up poll; the (tenantId, apiNotificationId) pair is the
/// natural key used by the upsert.
model Notification {
  id                String             @id @default(uuid(7)) @db.Uuid
  tenantId          String             @map("tenant_id") @db.Uuid
  apiNotificationId String             @map("api_notification_id")
  type              String
  severity          String             // INFO | WARNING | ERROR
  title             String
  message           String
  metadata          Json?
  /// API-side issuer id, NOT a local Issuer.id FK — always compare against
  /// Issuer.apiIssuerId. Both are UUIDs, so they are structurally
  /// interchangeable and the compiler cannot catch a mix-up here.
  issuerId          String?            @map("issuer_id") @db.Uuid
  apiReadAt         DateTime?          @map("api_read_at")
  expiresAt         DateTime?          @map("expires_at")
  apiCreatedAt      DateTime           @map("api_created_at")
  syncedAt          DateTime           @updatedAt @map("synced_at")
  reads             NotificationRead[]

  @@unique([tenantId, apiNotificationId])
  @@index([tenantId, apiReadAt])
  @@map("notifications")
}

/// Per-user read state for a notification. The API-level read (apiReadAt) is
/// set only once every eligible user has an entry here.
model NotificationRead {
  id             String       @id @default(uuid(7)) @db.Uuid
  notificationId String       @map("notification_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  readAt         DateTime     @default(now()) @map("read_at")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([userId])
  @@map("notification_reads")
}

/// One in-progress draft per legal document type (TERMS / PRIVACY / DPA).
/// Upserted on every "Guardar borrador" click; deleted when the draft is
/// published or explicitly discarded. Global (no per-user scope) because
/// only super admins can edit legal documents and there is no meaningful
/// multi-author scenario here.
model AgreementDraft {
  id           String   @id @default(uuid(7)) @db.Uuid
  documentType String   @unique @map("document_type")
  version      String   @default("")
  content      String
  updatedAt    DateTime @updatedAt @map("updated_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("agreement_drafts")
}

/// A webhook endpoint registered with the Comprobify API. The signing secret
/// is stored encrypted (AES-256-GCM) the same way as TenantApiKey.encryptedKey.
model WebhookEndpoint {
  id              String   @id @default(uuid(7)) @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  apiEndpointId   String   @map("api_endpoint_id")
  url             String
  encryptedSecret String   @map("encrypted_secret")
  eventTypes      String[]  @map("event_types")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")

  @@unique([tenantId, apiEndpointId])
  @@index([tenantId])
  @@map("webhook_endpoints")
}
