# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the frontend user database
DATABASE_URL=postgresql://user:password@localhost:5432/comprobify_web

# ── Comprobify API connection ──────────────────────────────────────────────────
# Base URL of the Comprobify API (no trailing slash)
COMPROBIFY_API_URL=http://localhost:8080

# Admin secret for issuer provisioning (POST /api/admin/issuers, etc.)
# Must match COMPROBIFY_ADMIN_SECRET in the Comprobify API config
COMPROBIFY_ADMIN_SECRET=your-admin-secret-here

# ── Auth.js (next-auth) ────────────────────────────────────────────────────────
# Random 32+ char string — generate: openssl rand -base64 32
AUTH_SECRET=replace-me-in-production
