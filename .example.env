# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the frontend user database
DATABASE_URL=postgresql://user:password@localhost:5432/comprobify_web

# ── Comprobify API connection ──────────────────────────────────────────────────
# Base URL of the Comprobify API (no trailing slash)
COMPROBIFY_API_URL=http://localhost:8080

# ── Auth.js (next-auth) ────────────────────────────────────────────────────────
# Random 32+ char string — generate: openssl rand -base64 32
AUTH_SECRET=replace-me-in-production

# ── App public URL ────────────────────────────────────────────────────────────
# Full URL with protocol — used to build absolute callback URLs (e.g. email
# verification links) sent to the Comprobify API. Set to your deployed domain
# in production (https://your-app.com). Required for email verification to work.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── API key encryption ─────────────────────────────────────────────────────────
# Encrypts TenantApiKey values at rest (AES-256-GCM). Must be a 32-byte hex
# string (64 hex chars) — generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-me-in-production

# ── Context cookie ─────────────────────────────────────────────────────────────
# Signs the comprobify_ctx cookie (issuer selection). Generate:
# openssl rand -hex 32
CONTEXT_COOKIE_SECRET=replace-me-in-production

# ── Sentry error monitoring ────────────────────────────────────────────────────
# Leave unset locally — Sentry is intentionally disabled in local dev.
# Set in Vercel env vars for staging and production deployments.
# SENTRY_DSN is used server-side; NEXT_PUBLIC_SENTRY_DSN is sent to the browser.
# Both should be the same DSN value.
# APP_ENV / NEXT_PUBLIC_APP_ENV tag each error with its environment in Sentry
# ("staging" or "production") so you can filter and alert per env.
SENTRY_DSN=https://your-key@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
# Required for source map uploads during CI/CD builds
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ── Admin only (optional) ─────────────────────────────────────────────────────
# Only needed if building admin tooling (manage tenant tiers, etc.)
# Self-service registration and production promotion do NOT require this.
# COMPROBIFY_ADMIN_SECRET=your-admin-secret-here
