# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string for the frontend user database
DATABASE_URL=postgresql://user:password@localhost:5432/comprobify_web
#
# Optional `connection_limit=N` query param: caps how many connections this
# app's Prisma client opens. Set this whenever the database shares a
# connection budget with something else (e.g. a managed Postgres cluster also
# used by the Comprobify API) — Vercel serverless functions can otherwise
# spike connection demand fast, since each invocation may open a fresh
# connection with no built-in ceiling. This app uses @prisma/adapter-pg
# (node-postgres), which does NOT read Prisma's connection_limit/pgbouncer
# query-string convention itself — src/lib/db.ts parses connection_limit out
# of this URL and passes it through as node-postgres's own `max` pool option.
# There is deliberately no `pgbouncer=true` param even when routed through a
# PgBouncer-style pooler: the adapter only caches named prepared statements
# if a statementNameGenerator is explicitly configured, which this app never
# does, so it's already safe under transaction-mode pooling without the flag.
# See docs/deployment.md's "Environment variables" section for the full
# reasoning and the staging/production values currently in use.
#
# Do NOT add `sslmode`/`sslcert`/`sslkey`/`sslrootcert` as query params here
# either — see DATABASE_SSL/DATABASE_SSL_CA below for why, and use those
# instead. (node-postgres's own connection-string parsing takes precedence
# over anything passed alongside it in code, so an sslmode here would
# silently override — not just be ignored like connection_limit would if
# misused elsewhere.)

# Leave unset locally (plain Postgres, no TLS). Required — set to "true" — on
# any deployment connecting to a provider that enforces SSL (which is any
# real managed Postgres, including DigitalOcean and Neon).
# DATABASE_SSL=true
#
# Required only when DATABASE_SSL=true AND the provider uses a private,
# cluster-specific CA rather than a publicly-trusted one — e.g. DigitalOcean
# managed Postgres. Download the CA certificate from the provider's
# dashboard (DO: cluster's Connection Details → "CA Certificate") and paste
# its full PEM content here. Omit for a provider with a publicly-trusted
# chain (e.g. Neon), where `rejectUnauthorized: true` alone verifies
# correctly. Without it against a private-CA provider, connections fail with
# SELF_SIGNED_CERT_IN_CHAIN. Mirrors DB_SSL_CA in the comprobify API repo.
# DATABASE_SSL_CA=

# ── Comprobify API connection ──────────────────────────────────────────────────
# Base URL of the Comprobify API (no trailing slash)
COMPROBIFY_API_URL=http://localhost:8080

# ── Auth.js (next-auth) ────────────────────────────────────────────────────────
# Random 32+ char string — generate: openssl rand -hex 32
AUTH_SECRET=replace-me-in-production

# ── App public URL ────────────────────────────────────────────────────────────
# Full URL with protocol — used to build absolute callback URLs (e.g. email
# verification links) sent to the Comprobify API. Set to your deployed domain
# in production (https://your-app.com). Required for email verification to work.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Marketing site / SEO ───────────────────────────────────────────────────────
# Public origin of the MARKETING host (comprobify.com / staging.comprobify.com),
# not the app host — used as the canonical base URL for metadata, robots.txt,
# and sitemap.xml on the (marketing) routes. Different value per Vercel
# environment:
#   production: https://comprobify.com
#   staging:    https://staging.comprobify.com
#   local:      http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
# robots.txt/sitemap.xml only allow indexing when this is "production" — reuses
# the same flag Sentry uses to tag environments (see below). Staging and local
# builds always emit a blanket "Disallow: /" so the staging domain never gets
# indexed.
# NEXT_PUBLIC_APP_ENV=production

# ── API key encryption ─────────────────────────────────────────────────────────
# Encrypts TenantApiKey values at rest (AES-256-GCM). Must be a 32-byte hex
# string (64 hex chars) — generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-me-in-production

# ── Context cookie ─────────────────────────────────────────────────────────────
# Signs the comprobify_ctx cookie (issuer selection). Generate:
# openssl rand -hex 32
CONTEXT_COOKIE_SECRET=replace-me-in-production

# ── Sentry error monitoring ────────────────────────────────────────────────────
# Leave unset locally — Sentry is intentionally disabled in local dev.
# Set in Vercel env vars for staging and production deployments.
# SENTRY_DSN is used server-side; NEXT_PUBLIC_SENTRY_DSN is sent to the browser.
# Both should be the same DSN value.
# APP_ENV / NEXT_PUBLIC_APP_ENV tag each error with its environment in Sentry
# ("staging" or "production") so you can filter and alert per env.
SENTRY_DSN=https://your-key@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
NEXT_PUBLIC_SENTRY_DSN=https://your-key@oXXXXXXX.ingest.us.sentry.io/XXXXXXX
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production
# Required for source map uploads during CI/CD builds
SENTRY_AUTH_TOKEN=your-sentry-auth-token

# ── Mailgun (user invite emails) ───────────────────────────────────────────────
# Used by inviteUserAction/resendInviteAction (src/app/actions/users.ts) to email
# invited tenant users a link to /complete-registration. Separate integration from
# the Comprobify API's own Mailgun setup (which sends invoice/verification emails) —
# this app sends its own transactional emails for tenant user management.
MAILGUN_API_KEY=your-mailgun-api-key
MAILGUN_DOMAIN=mg.your-domain.com
MAILGUN_FROM=Comprobify <no-reply@mg.your-domain.com>

# ── Admin tooling (super admin panel) ──────────────────────────────────────────
# Bearer secret for the Comprobify API's /admin/* routes (authenticate-admin.js),
# used by src/lib/admin-api.ts for the /admin super-admin panel (tenant management,
# payment-proof review, legal document management). Must match the API's own
# ADMIN_SECRET env var. Self-service registration and production promotion do NOT
# require this.
COMPROBIFY_ADMIN_SECRET=your-admin-secret-here

# Password for the super-admin user seeded by `npm run db:seed`.
# Only needed when running the seed script (prisma/seed.js) to create or reset
# the support@comprobify.com admin account. Not read at runtime by Next.js.
ADMIN_SEED_PASSWORD=change-me-before-seeding

# ── Support page ────────────────────────────────────────────────────────────
# Contact details shown on /support (linked from the sidebar, the marketing
# footer, and the login/register screens). Read server-side only.
SUPPORT_EMAIL=support@comprobify.com
# Include the country code. Non-digit characters (+, spaces, dashes) are
# stripped when building the https://wa.me/ link, so the displayed format
# here is just for readability.
SUPPORT_PHONE=+593 99 999 9999
