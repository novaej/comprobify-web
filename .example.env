# ── Comprobify API connection ─────────────────────────────────────────────────
# API key from your Comprobify issuer (POST /api/admin/issuers, then POST /api/admin/api-keys)
COMPROBIFY_API_KEY=your-api-key-here

# Base URL of the Comprobify API (no trailing slash)
COMPROBIFY_API_URL=http://localhost:8080

# Set to "true" when the API key points to a sandbox issuer (sandbox = true).
# Controls the yellow sandbox banner shown in the UI.
COMPROBIFY_SANDBOX=true

# ── Next.js ───────────────────────────────────────────────────────────────────
# Required by Next.js — any random 32+ char string works for local dev
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=replace-me-in-production
