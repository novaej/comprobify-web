        <mxCell id="web-e7" edge="1" parent="1" source="web-dev" style="edgeStyle=orthogonalEdgeStyle;html=1;" target="web-github" value="git push (PR merge to main)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="web-e8" edge="1" parent="1" source="web-github" style="edgeStyle=orthogonalEdgeStyle;html=1;" target="web-actions" value="triggers">
