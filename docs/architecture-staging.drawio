<mxfile host="app.diagrams.net">
  <diagram name="Staging Architecture" id="comprobify-web-staging-arch">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="web-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;" value="Comprobify Web — Staging Architecture" vertex="1">
          <mxGeometry height="40" width="560" x="340" y="15" as="geometry" />
        </mxCell>

        <mxCell id="web-cicd-wrapper" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;strokeColor=#cccccc;fillColor=#f9f9f9;dashed=1;spacingLeft=8;spacingTop=6;" value="CI / CD" vertex="1">
          <mxGeometry height="290" width="840" x="55" y="520" as="geometry" />
        </mxCell>

        <mxCell id="web-ext-wrapper" parent="1" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontStyle=1;strokeColor=#cccccc;fillColor=#f9f9f9;dashed=1;spacingLeft=8;spacingTop=6;" value="External Services" vertex="1">
          <mxGeometry height="380" width="220" x="1170" y="70" as="geometry" />
        </mxCell>

        <mxCell id="web-browser" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Browser / Users&lt;/b&gt;&lt;br/&gt;non-technical staff&lt;br/&gt;creating &amp; authorizing facturas" vertex="1">
          <mxGeometry height="70" width="170" x="60" y="195" as="geometry" />
        </mxCell>

        <mxCell id="web-cf-dns" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;" value="&lt;b&gt;Cloudflare DNS&lt;/b&gt;&lt;br/&gt;staging.comprobify.com&lt;br/&gt;app-staging.comprobify.com&lt;br/&gt;A records → droplet's reserved IP, proxied (WAF/DDoS/bot layer)" vertex="1">
          <mxGeometry height="105" width="230" x="300" y="175" as="geometry" />
        </mxCell>

        <mxCell id="web-platform" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" value="&lt;b&gt;DigitalOcean Droplet&lt;/b&gt;&lt;br/&gt;comprobify-web-staging (s-1vcpu-1gb)&lt;br/&gt;Caddy (TLS, reverse proxy) → web container&lt;br/&gt;Docker Compose · deploys from: main&lt;br/&gt;build: prisma generate &amp;&amp; next build&lt;br/&gt;run: prisma migrate deploy &amp;&amp; next start&lt;br/&gt;proxy.ts routes marketing vs. app host" vertex="1">
          <mxGeometry height="140" width="270" x="600" y="160" as="geometry" />
        </mxCell>

        <mxCell id="web-db" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;DigitalOcean Managed PostgreSQL&lt;/b&gt;&lt;br/&gt;Basic-plan cluster, shared with the&lt;br/&gt;Comprobify API (no pooler) — each&lt;br/&gt;consumer caps its own pool via&lt;br/&gt;?connection_limit on DATABASE_URL&lt;br/&gt;users · tenants · issuers · notifications" vertex="1">
          <mxGeometry height="105" width="190" x="1185" y="95" as="geometry" />
        </mxCell>

        <mxCell id="web-api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" value="&lt;b&gt;Comprobify API (staging)&lt;/b&gt;&lt;br/&gt;api-staging.comprobify.com&lt;br/&gt;DigitalOcean Droplet (project comprobify-staging)&lt;br/&gt;Bearer token (decrypted TenantApiKey)" vertex="1">
          <mxGeometry height="90" width="190" x="1185" y="220" as="geometry" />
        </mxCell>

        <mxCell id="web-sentry" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" value="&lt;b&gt;Sentry&lt;/b&gt;&lt;br&gt;Error monitoring&lt;br&gt;environment: staging&lt;br&gt;org: novaej" vertex="1">
          <mxGeometry height="80" width="190" x="1185" y="335" as="geometry" />
        </mxCell>

        <mxCell id="web-dev" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" value="&lt;b&gt;Developer&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="120" x="70" y="575" as="geometry" />
        </mxCell>

        <mxCell id="web-github" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#24292e;" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br/&gt;comprobify-web repo&lt;br/&gt;branches: main / production" vertex="1">
          <mxGeometry height="80" width="170" x="270" y="560" as="geometry" />
        </mxCell>

        <mxCell id="web-actions" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#24292e;align=left;spacingLeft=10;fontSize=10;" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;deploy-staging.yml — push to main → build+push GHCR, SCP compose files, SSH write .env + restart (currently disabled, staging droplet destroyed)&lt;br/&gt;release-production.yml — GitHub Release published → fast-forward production branch (RELEASE_PUSH_TOKEN)&lt;br/&gt;deploy-production.yml — push to production → same shape, ships to production droplet — see architecture-production.drawio" vertex="1">
          <mxGeometry height="120" width="360" x="520" y="535" as="geometry" />
        </mxCell>

        <mxCell id="web-terraform" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=10;fontSize=10;" value="&lt;b&gt;Terraform&lt;/b&gt; (terraform.yml)&lt;br/&gt;&lt;br/&gt;Triggers on push to main (path: terraform/**)&lt;br/&gt;terraform/environments/staging → modules/droplet&lt;br/&gt;State: DigitalOcean Spaces (comprobify-terraform-state)&lt;br/&gt;Provisions: droplet + reserved IP + firewall + Cloudflare A records — never app secrets (those are deploy-staging.yml's job, over SSH)" vertex="1">
          <mxGeometry height="120" width="360" x="520" y="695" as="geometry" />
        </mxCell>

        <mxCell id="web-e1" edge="1" parent="1" source="web-browser" style="edgeStyle=orthogonalEdgeStyle;html=1;" target="web-cf-dns" value="HTTPS">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="web-e2" edge="1" parent="1" source="web-cf-dns" style="edgeStyle=orthogonalEdgeStyle;html=1;" target="web-platform" value="proxy (A record)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="web-e3" edge="1" parent="1" source="web-platform" style="edgeStyle=orthogonalEdgeStyle;html=1;" target="web-db" value="PostgreSQL / SSL, shared cluster">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
