        <mxCell id="web-vercel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="&lt;b&gt;Vercel — comprobify-web-staging&lt;/b&gt;&lt;br&gt;Next.js 16 · Turbopack&lt;br&gt;Branch: staging&lt;br&gt;vercel-build: prisma migrate deploy + next build&lt;br&gt;proxy.ts routes marketing vs. app host" vertex="1">
          <mxGeometry height="110" width="270" x="600" y="170" as="geometry" />
