        <mxCell id="web-e5" edge="1" parent="1" source="web-api" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" target="web-platform" value="webhook (HMAC-SHA256, notifications)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="950" y="285" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="web-e6" edge="1" parent="1" source="web-platform" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;" target="web-sentry" value="captured + uncaught exceptions">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1000" y="375" />
            </Array>
          </mxGeometry>
