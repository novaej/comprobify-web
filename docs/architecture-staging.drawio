        </mxCell>

        <mxCell id="web-e10" edge="1" parent="1" source="web-actions" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" target="web-platform" value="build → push GHCR → SCP compose files → SSH write .env + docker compose up -d">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="480" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="web-e11" edge="1" parent="1" source="web-github" style="edgeStyle=orthogonalEdgeStyle;html=1;" target="web-terraform" value="push to main (path terraform/**)">
