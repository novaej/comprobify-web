        <mxCell id="web-cf-dns" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d6b656;" value="&lt;b&gt;Cloudflare DNS&lt;/b&gt;&lt;br/&gt;staging.comprobify.com&lt;br/&gt;app-staging.comprobify.com&lt;br/&gt;CNAME → App Platform ingress, DNS only (no proxy — App Platform terminates its own TLS/cert)" vertex="1">
          <mxGeometry height="105" width="230" x="300" y="175" as="geometry" />
        </mxCell>

        <mxCell id="web-platform" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=8;" value="&lt;b&gt;DigitalOcean App Platform&lt;/b&gt;&lt;br/&gt;comprobify-web-staging&lt;br/&gt;Next.js 16 · watches branch: staging&lt;br/&gt;build: prisma generate &amp;&amp; next build&lt;br/&gt;run: prisma migrate deploy &amp;&amp; next start&lt;br/&gt;region nyc (VPC: nyc1) · instance basic-xxs&lt;br/&gt;proxy.ts routes marketing vs. app host" vertex="1">
          <mxGeometry height="140" width="270" x="600" y="160" as="geometry" />
        </mxCell>

        <mxCell id="web-db" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="&lt;b&gt;DigitalOcean Managed PostgreSQL&lt;/b&gt;&lt;br/&gt;Basic-plan cluster, shared with the&lt;br/&gt;Comprobify API (no pooler) — each&lt;br/&gt;consumer caps its own pool via&lt;br/&gt;?connection_limit on DATABASE_URL&lt;br/&gt;users · tenants · issuers · notifications" vertex="1">
          <mxGeometry height="105" width="190" x="1185" y="95" as="geometry" />
        </mxCell>

        <mxCell id="web-api" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" value="&lt;b&gt;Comprobify API (staging)&lt;/b&gt;&lt;br/&gt;api-staging.comprobify.com&lt;br/&gt;DigitalOcean Droplet (project comprobify-staging)&lt;br/&gt;Bearer token (decrypted TenantApiKey)" vertex="1">
