# Ranges from https://www.cloudflare.com/ips-v4 (same source as
# terraform/modules/droplet/main.tf's firewall allowlist, and the same list the
# comprobify API repo's own Caddyfile uses). client_ip_headers defaults to
# X-Forwarded-For only - CF-Connecting-IP must be listed explicitly or Caddy never
# reads it, and still uses its own peer IP as the client.
{
    servers {
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
        client_ip_headers CF-Connecting-IP X-Forwarded-For
    }
}

# PUBLIC_DOMAIN_PRIMARY/PUBLIC_DOMAIN_ALIAS are written into .env per environment
# (staging.comprobify.com / app-staging.comprobify.com, or comprobify.com /
# app.comprobify.com in production) and passed to this container via
# docker-compose.yml's caddy service - one file, both environments, mirroring the
# comprobify API repo's own single-{$PUBLIC_DOMAIN}-var Caddyfile, just with two
# vars instead of one since this app serves a marketing host and an app host from
# the same container (src/proxy.ts's host-header logic routes between them, not
# Caddy) - a single PUBLIC_DOMAIN var can't hold two hostnames at once.
#
# Caddy requests separate certificates for each SNI name automatically.
{$PUBLIC_DOMAIN_PRIMARY}, {$PUBLIC_DOMAIN_ALIAS} {
    reverse_proxy web:3000 {
        header_up X-Real-Client-IP {client_ip}
    }
}
